{
  "version": 2,
  "builds": [
    {
      "src": "Server/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "Client/**"
        ]
      }
    },
    {
      "src": "Client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Server/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/Client/$1"
    }
  ]
}